rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function owner(uid) { return signed() && request.auth.uid == uid; }
  function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
  function identity(d) { return owner(d.uid) && text(d.name,30) && text(d.avatar,1000) && d.createdAt is number; }
  function member(roomId) { return signed() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members; }
  function roomNotBlocked(roomId) {
   let members = get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
   return !exists(/databases/$(database)/documents/users/$(members[0])/blocked/$(members[1]))
     && !exists(/databases/$(database)/documents/users/$(members[1])/blocked/$(members[0]));
  }
  match /users/{userId} {
   allow read: if signed();
   allow create, update: if owner(userId) && request.resource.data.keys().hasOnly(['name','avatar','username','bio','instagram','updatedAt']) && text(request.resource.data.name,30) && text(request.resource.data.avatar,1000) && text(request.resource.data.username,20) && request.resource.data.bio is string && request.resource.data.bio.size() <= 100 && request.resource.data.instagram is string && request.resource.data.instagram.size() <= 30 && request.resource.data.updatedAt is number;
   allow delete: if owner(userId);
   match /following/{postId} { allow read, write: if owner(userId); }
   match /blocked/{blockedId} { allow read, write: if owner(userId); }
   match /groupInvites/{groupId} {
    allow read: if owner(userId);
    allow create: if signed() && request.resource.data.toUid == userId
      && request.resource.data.fromUid == request.auth.uid
      && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    allow update: if owner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      && request.resource.data.status in ['accepted','declined'];
    allow delete: if owner(userId) || owner(resource.data.fromUid);
   }
   match /notifications/{notificationId} {
    allow read: if owner(userId);
    allow update: if owner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    allow create, delete: if false;
   }
   match /devices/{deviceId} {
    allow read, create, update, delete: if owner(userId);
   }
  }
  match /usernames/{username} {
   allow read: if signed();
   allow create: if signed() && request.resource.data.uid == request.auth.uid;
   allow update, delete: if signed() && resource.data.uid == request.auth.uid;
  }
  function postExists(postId) { return exists(/databases/$(database)/documents/posts/$(postId)); }
  match /posts/{postId} {
   allow read: if signed();
   allow create: if identity(request.resource.data)
     && request.resource.data.keys().hasOnly(['uid','name','avatar','text','topic','mood','createdAt','media'])
     && text(request.resource.data.text,2000)
     && request.resource.data.topic in ['Vida cotidiana','Relaciones','Sexualidad','Universidad','Ansiedad','Amistad','Pequeñas victorias']
     && request.resource.data.mood in ['🌤️','🌧️','🌀','🌱','🔥'];
   allow delete: if owner(resource.data.uid);
   allow update: if false;
   match /replies/{replyId} {
    allow read: if signed() && postExists(postId);
    allow create: if postExists(postId) && identity(request.resource.data) && text(request.resource.data.text,1000) && request.resource.data.keys().hasOnly(['uid','name','avatar','text','createdAt','media']);
    allow delete: if owner(resource.data.uid);
    match /votes/{uid} {
     allow read: if signed();
     allow create, update: if owner(uid) && request.resource.data.uid == uid && request.resource.data.value in [-1,1];
     allow delete: if owner(uid);
    }
   }
   match /hearts/{uid} {
    allow read: if signed() && postExists(postId);
    allow create: if postExists(postId) && owner(uid) && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid;
    allow delete: if owner(uid);
   }
  }
  match /reports/{reportId} {
   allow create: if owner(request.resource.data.uid) && request.resource.data.keys().hasOnly(['postId','uid','reason','createdAt']) && text(request.resource.data.postId,200) && text(request.resource.data.reason,200) && request.resource.data.createdAt is number;
   allow read, update, delete: if false;
  }
  match /rooms/{roomId} {
   allow get: if signed() && (!exists(/databases/$(database)/documents/rooms/$(roomId)) || request.auth.uid in resource.data.members);
   allow list: if signed() && request.auth.uid in resource.data.members;
   allow create: if signed() && request.resource.data.keys().hasOnly(['id','members','names','createdAt'])
     && request.resource.data.id == roomId && request.resource.data.members is list && request.resource.data.members.size() == 2
     && request.resource.data.members[0] != request.resource.data.members[1]
     && request.auth.uid in request.resource.data.members && request.resource.data.names is map
     && request.resource.data.names.keys().hasOnly(request.resource.data.members)
     && text(request.resource.data.names[request.resource.data.members[0]],30)
     && text(request.resource.data.names[request.resource.data.members[1]],30)
     && request.resource.data.createdAt is number;
   allow update: if signed() && request.auth.uid in resource.data.members && request.resource.data == resource.data;
   allow delete: if signed() && request.auth.uid in resource.data.members;
   match /messages/{messageId} {
    allow read: if member(roomId);
    allow create: if member(roomId) && roomNotBlocked(roomId) && owner(request.resource.data.uid) && text(request.resource.data.text,2000) && request.resource.data.createdAt is number && request.resource.data.keys().hasOnly(['uid','text','createdAt','media']);
   }
  }
  match /groups/{groupId} {
   allow get, list: if signed() && request.auth.uid in resource.data.members;
   allow create: if signed() && request.resource.data.ownerId == request.auth.uid
     && request.resource.data.members == [request.auth.uid]
     && request.resource.data.names[request.auth.uid] is string
     && text(request.resource.data.name,40) && request.resource.data.createdAt is number;
   allow update: if signed() && (
     resource.data.ownerId == request.auth.uid ||
     (!(request.auth.uid in resource.data.members)
       && request.auth.uid in request.resource.data.members
       && request.resource.data.members.size() == resource.data.members.size() + 1
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names'])
       && exists(/databases/$(database)/documents/users/$(request.auth.uid)/groupInvites/$(groupId)))
     );
   allow delete: if signed() && resource.data.ownerId == request.auth.uid;
   match /messages/{messageId} {
    allow read: if signed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    allow create: if signed() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
      && owner(request.resource.data.uid) && text(request.resource.data.text,2000)
      && request.resource.data.createdAt is number
      && request.resource.data.keys().hasOnly(['uid','text','createdAt','media']);
   }
  }
 }
}
